NODE_ENV=production
HOST=0.0.0.0
PORT=5000

# Публичный URL сайта (как в браузере). Несколько origin через запятую.
FRONTEND_URL=https://example.com

# Обязательно смените. Длинная случайная строка.
JWT_SECRET=change-me-in-production

# MySQL на том же или другом хосте
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kanban
DB_USER=kanban
DB_PASSWORD=change-me

# HTTPS за nginx/caddy: оставьте true. Для HTTP (IP без TLS) поставьте false.
COOKIE_SECURE=true
TRUST_PROXY=true

# Bitrix24: Redirect URI в кабинете приложения должен совпадать
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=
BITRIX24_REDIRECT_URI=https://example.com/api/bitrix24/callback
BITRIX24_DOMAIN=your-company.bitrix24.ru
# BITRIX24_ALLOW_CUSTOM_PORTAL=true

# Необязательно: путь к сборке Vue (по умолчанию ../client/dist)
# CLIENT_DIST=
# SERVE_CLIENT=false
