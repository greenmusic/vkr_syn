{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:prod": "node src/index.js",
    "dev": "nodemon src/index.js",
    "dev:bg": "start /B nodemon src/index.js",
    "start:bg": "pm2 restart backend --watch || pm2 start src/index.js --name backend --watch",
    "stop:bg": "pm2 stop backend || taskkill /F /IM node.exe /FI \"WINDOWTITLE eq nodemon src/index.js\" 2>nul || taskkill /F /IM nodemon.exe 2>nul || echo \"No backend process running\"",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
