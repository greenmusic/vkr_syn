# Скопируйте в sites-available и подставьте свой домен.
# Node слушает 127.0.0.1:5000 (в server/.env: HOST=127.0.0.1 PORT=5000).
#
# sudo ln -s /etc/nginx/sites-available/vkr_syn /etc/nginx/sites-enabled/
# sudo nginx -t && sudo systemctl reload nginx
#
# В server/.env:
#   FRONTEND_URL=https://ваш-домен
#   COOKIE_SECURE=true
#   TRUST_PROXY=true
#   BITRIX24_REDIRECT_URI=https://ваш-домен/api/bitrix24/callback

server {
    listen 80;
    listen [::]:80;
    server_name YOUR_DOMAIN;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name YOUR_DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/YOUR_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/YOUR_DOMAIN/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Фон доски до 4 МБ
    client_max_body_size 8m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
